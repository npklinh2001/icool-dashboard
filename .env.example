# SQL Server connection
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# SQL Server 2012 only speaks TLS 1.0/1.2 - keep false unless the server has a valid certificate
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Session signing key: at least 32 random characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
AUTH_SESSION_HOURS=12
